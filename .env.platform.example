# Dedicated local development configuration; never reuse these passwords on the Internet.
PLATFORM_ENVIRONMENT=local
PLATFORM_DATABASE_URL=mysql+asyncmy://research:local-research-only@127.0.0.1:53306/research_platform
PLATFORM_RABBIT_URL=amqp://research:local-research-only@127.0.0.1:55672/
PLATFORM_REDIS_URL=redis://127.0.0.1:56379/0
PLATFORM_OBJECT_ENDPOINT=http://127.0.0.1:59000
PLATFORM_OBJECT_BUCKET=research-platform
PLATFORM_OBJECT_ACCESS_KEY=research-local
PLATFORM_OBJECT_SECRET_KEY=local-research-only
PLATFORM_PUBLIC_ORIGIN=http://localhost:3000
PLATFORM_REQUIRE_EMAIL_VERIFICATION=true
PLATFORM_SMTP_HOST=127.0.0.1
PLATFORM_SMTP_PORT=51025
PLATFORM_RATE_LIMIT_ENABLED=true
PLATFORM_ADMIN_EMAILS=
